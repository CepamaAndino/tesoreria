<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Datos de transferencia ·  Bingo Andino</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#fff7ec; --card:#ffffff; --ink:#2b2340; --muted:#6d6585;
    --brand:#ff6b4a; --brand2:#ffb627; --ok:#22a06b; --line:#f0e3d0;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Nunito',system-ui,sans-serif;
    background-image:radial-gradient(circle at 10% 0%,#ffe1cc 0,transparent 40%),radial-gradient(circle at 100% 30%,#fff0b8 0,transparent 35%);
    min-height:100vh;padding:24px 16px 40px}
  .wrap{max-width:440px;margin:0 auto}
  header{text-align:center;margin-bottom:18px}
  .emoji{font-size:44px;line-height:1}
  h1{font-family:'Baloo 2',sans-serif;font-weight:800;font-size:30px;margin:6px 0 2px;line-height:1.1}
  h1 span{color:var(--brand)}
  .sub{color:var(--muted);margin:0;font-size:15px}
  .card{background:var(--card);border-radius:20px;box-shadow:0 8px 24px rgba(43,35,64,.08);padding:6px 16px;border:2px solid var(--line)}
  .row{display:flex;align-items:center;gap:10px;padding:13px 0;border-bottom:1px dashed var(--line)}
  .row:last-child{border-bottom:0}
  .lbl{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700}
  .val{font-size:17px;font-weight:700;word-break:break-word}
  .info{flex:1;min-width:0}
  button.copy{flex:none;border:0;border-radius:12px;padding:9px 12px;background:#fff1e8;color:var(--brand);
    font-family:'Baloo 2',sans-serif;font-weight:700;font-size:15px;cursor:pointer;transition:.15s}
  button.copy:active{transform:scale(.95)}
  button.copy.done{background:#e3f6ec;color:var(--ok)}
  .all{display:block;width:100%;margin:18px 0 0;border:0;border-radius:16px;padding:15px;
    background:linear-gradient(135deg,var(--brand),#ff8f3a);color:#fff;font-family:'Baloo 2',sans-serif;
    font-weight:800;font-size:19px;cursor:pointer;box-shadow:0 6px 16px rgba(255,107,74,.35)}
  .all.done{background:var(--ok);box-shadow:none}
  .tip{margin-top:18px;background:#fff8d6;border:2px solid #ffe58a;border-radius:16px;padding:14px 16px;font-size:15px;line-height:1.45}
  .tip b{font-family:'Baloo 2',sans-serif}
  footer{text-align:center;color:var(--muted);font-size:13px;margin-top:22px}
  .toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(80px);background:var(--ink);color:#fff;
    padding:10px 18px;border-radius:999px;font-weight:700;transition:.25s;opacity:0}
  .toast.show{transform:translateX(-50%) translateY(0);opacity:1}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="emoji">🥤🎱</div>
    <h1>Bebidas del <span>Bingo Andino</span></h1>
    <p class="sub">Paga por transferencia, ¡así de fácil!</p>
  </header>

  <div class="card" id="datos">
    <div class="row"><div class="info"><div class="lbl">Titular</div><div class="val">Patricia Bravo Alcaino</div></div><button class="copy" data-v="Patricia Bravo Alcaino">Copiar</button></div>
    <div class="row"><div class="info"><div class="lbl">RUT</div><div class="val">16.859.492-5</div></div><button class="copy" data-v="16.859.492-5">Copiar</button></div>
    <div class="row"><div class="info"><div class="lbl">Banco</div><div class="val">BancoEstado</div></div><button class="copy" data-v="BancoEstado">Copiar</button></div>
    <div class="row"><div class="info"><div class="lbl">Tipo de cuenta</div><div class="val">Cuenta Corriente</div></div><button class="copy" data-v="Cuenta Corriente">Copiar</button></div>
    <div class="row"><div class="info"><div class="lbl">N° de cuenta</div><div class="val">33000074697</div></div><button class="copy" data-v="33000074697">Copiar</button></div>
    <div class="row"><div class="info"><div class="lbl">Email</div><div class="val">cepama@colegioandino.cl</div></div><button class="copy" data-v="cepama@colegioandino.cl">Copiar</button></div>
  </div>

  <button class="all" id="all">📋 Copiar todos los datos</button>

  <div class="tip">
    <b>💡 Después de transferir:</b> muestra el comprobante en la mesa de bebidas y ¡listo! Gracias por apoyar al CEPAMA 💛
  </div>

  <footer>CEPAMA · Colegio Andino Montessori</footer>
</div>
<div class="toast" id="toast">¡Copiado! ✅</div>

<script>
  const todo = `Titular: Patricia Bravo Alcaino
RUT: 16.859.492-5
Banco: BancoEstado
Tipo de cuenta: Cuenta Corriente
N° de cuenta: 33000074697
Email: cepama@colegioandino.cl`;

  const toast = document.getElementById('toast');
  let t;
  function avisar(){ toast.classList.add('show'); clearTimeout(t); t=setTimeout(()=>toast.classList.remove('show'),1400); }

  async function copiar(texto){
    try { await navigator.clipboard.writeText(texto); return true; }
    catch(e){
      const ta=document.createElement('textarea'); ta.value=texto; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select();
      let ok=false; try{ ok=document.execCommand('copy'); }catch(_){}
      ta.remove(); return ok;
    }
  }

  document.querySelectorAll('button.copy').forEach(b=>{
    b.addEventListener('click', async ()=>{
      if(await copiar(b.dataset.v)){
        b.textContent='✓ Listo'; b.classList.add('done'); avisar();
        setTimeout(()=>{ b.textContent='Copiar'; b.classList.remove('done'); },1600);
      }
    });
  });

  const all=document.getElementById('all');
  all.addEventListener('click', async ()=>{
    if(await copiar(todo)){
      all.textContent='✅ ¡Datos copiados!'; all.classList.add('done'); avisar();
      setTimeout(()=>{ all.textContent='📋 Copiar todos los datos'; all.classList.remove('done'); },1800);
    }
  });
</script>
</body>
</html>
